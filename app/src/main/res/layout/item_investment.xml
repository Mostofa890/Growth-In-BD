<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#1E293B">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/invAmount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="৳ 0"
                android:textColor="#22C55E"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/invStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● চলমান"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/invRate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="10% বার্ষিক"
                android:textColor="#38BDF8"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/invDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12 মাস"
                android:textColor="#94A3B8"
                android:textSize="13sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/invStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="শুরু: --"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/invEnd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="শেষ: --"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:layout_marginTop="10dp"
            android:background="#0F172A">

            <TextView
                android:id="@+id/invMonthly"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="মাসিক লাভ: ৳ 0"
                android:textColor="#F59E0B"
                android:textSize="12sp"
                android:padding="8dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/invTotalEarned"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="মোট লাভ: ৳ 0"
                android:textColor="#22C55E"
                android:textSize="12sp"
                android:padding="8dp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
